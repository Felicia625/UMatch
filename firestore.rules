rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // A verified UMN student account (the email claim is only true after the user clicked the verification link).
    function umnVerified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@student[.]umn[.]ac[.]id');
    }

    function otherUid(users) { return users[0] == request.auth.uid ? users[1] : users[0]; }
    function likedOf(uid) {
      return get(/databases/$(database)/documents/swipes/$(uid)).data.get('liked', []);
    }
    function isMember(matchId) {
      return request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    match /users/{uid} {
      allow read: if umnVerified();
      // Created right after sign-up, before the email is verified, so only the domain is checked here.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.auth.token.email.matches('.*@student[.]umn[.]ac[.]id');
      allow update: if umnVerified() && request.auth.uid == uid
                    && request.resource.data.get('name', null) == resource.data.get('name', null)
                    && request.resource.data.get('photoVerified', false) == resource.data.get('photoVerified', false);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Writes to other people's swipes/blocks stay open for verified users because deleting an account removes the
    // deleted uid from other users' lists (src/services/account.ts). Closing this needs a backend (Cloud Function).
    match /swipes/{uid} { allow read, write: if umnVerified(); }
    match /blocks/{uid} { allow read, write: if umnVerified(); }

    // The connections graph: each person publishes their own list of matches here, and only when they chose to show it
    // (visible = true). `friends` is the part of the list formed in Friend first mode (line colour). When hidden, both lists must be empty, so there is nothing for others to read.
    match /connections/{uid} {
      allow read: if umnVerified();
      allow create, update: if umnVerified() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['visible', 'partners', 'friends'])
                            && request.resource.data.visible is bool
                            && request.resource.data.partners is list
                            && request.resource.data.partners.size() <= 500
                            && request.resource.data.get('friends', []) is list
                            && request.resource.data.get('friends', []).size() <= 500
                            && (request.resource.data.visible
                                || (request.resource.data.partners.size() == 0 && request.resource.data.get('friends', []).size() == 0));
      allow delete: if umnVerified() && request.auth.uid == uid;
    }

    match /favorites/{uid} {
      allow read, write: if umnVerified() && request.auth.uid == uid;
    }

    match /matches/{matchId} {
      allow read: if umnVerified() && (resource == null || request.auth.uid in resource.data.users);
      // A match can only be created when both users have liked each other.
      allow create: if umnVerified()
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && otherUid(request.resource.data.users) in likedOf(request.auth.uid)
                    && request.auth.uid in likedOf(otherUid(request.resource.data.users));
      allow update: if umnVerified() && request.auth.uid in resource.data.users
                    && request.resource.data.users == resource.data.users;
      allow delete: if umnVerified() && request.auth.uid in resource.data.users;

      match /chats/{chatId} {
        allow read: if umnVerified() && isMember(matchId);
        allow create: if umnVerified() && isMember(matchId) && request.resource.data.senderId == request.auth.uid;
        // Only the sender can edit the text; either member can pin.
        allow update: if umnVerified() && isMember(matchId)
                      && (resource.data.senderId == request.auth.uid
                          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']));
        // Members can delete (deleting an account removes the whole conversation).
        allow delete: if umnVerified() && isMember(matchId);
      }
    }
  }
}
